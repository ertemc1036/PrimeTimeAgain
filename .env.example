# Public, client-safe values only. EXPO_PUBLIC_* variables are embedded in the app bundle.
# Never put secret keys (Supabase service role, Anthropic API key, RevenueCat secret/webhook keys) here.
# Leave a value empty and that feature reports itself as "not available" in the app.

# Supabase project (accounts, cloud AI features)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (subscriptions; also needs react-native-purchases and a development build)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Legal and support links shown in Profile → Information
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
